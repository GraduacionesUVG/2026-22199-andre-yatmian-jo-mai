//
//  Secrets.xcconfig.example
//  AR Tour Kaminaljuyu (iOS)
//
//  Variables de configuracion necesarias para compilar el proyecto.
//  En un proyecto iOS nativo no se usa un archivo .env: Xcode lee estos
//  valores desde Secrets.xcconfig en tiempo de compilacion.
//
//  Para configurarlas:
//    1. Copiar este archivo como Secrets.xcconfig dentro de
//       src/AR-Tour-Kaminaljuyu-iOS/ArTourKaminaljuyu/
//    2. Reemplazar los placeholders con los valores reales
//
//  Secrets.xcconfig esta en .gitignore y NO debe subirse al repositorio.
//

// Google Maps SDK para iOS - API Key
// Obtener en: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY = YOUR_API_KEY_HERE
